# Copy this file to .env and fill in real values.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
# True in development, False everywhere else.
DJANGO_DEBUG=True
# Comma-separated hostnames. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=
